<table id="recordings_table">
    <colgroup>
        <col id="col_id">
        <col id="col_thumb">
        <col id="col_source">
        <col id="col_dates">
        <col id="col_duration">
        <col id="col_actions">
    </colgroup>
    <thead>
        <tr class="recording_row">
            <th>ID</th>
            <th>Thumbnail</th>
            <th>Source</th>
            <th>Start Date</th>
            <th>Duration</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% 
            let bucket = null;
        %>

        <% for (let recording of data.recordings.toReversed()) { %>
            <%
                let time = (recording.startTS - recording.utcOffset);
                let currBucket = Math.floor(time / 3600000);
            %>

            <% if (bucket != currBucket) { %>
                <% bucket = currBucket; %>

                <tr class="separator_row">
                    <td colspan="6"><%= utils.formatDateTime(new Date(bucket * 3600000)) %></td>
                </tr>
            <% } %>

            <tr class="video_row">
                <td>
                    <%= recording.id %>
                </td>

                <td class="thumb_td">
                    <a href="/archive/recordings/<%= recording.id %>">
                        <img src="/archive/media/thumbs/<%= recording.id %>" alt="<%= recording.id %> thumbnail" class="thumb">
                    </a>
                    <img src="/archive/media/thumbs/<%= recording.id %>" class="thumb_popup">
                </td>

                <td>
                    <%= recording.source.name %>
                </td>

                <td class="date_td">
                    <div class="date_div">
                        <span class="local_date" title="Local Date">
                            <%= utils.formatDateTime(new Date(recording.startTS - recording.utcOffset)) %>
                        </span>
                        <span class="utc_date" title="UTC Date">
                            <%= utils.formatDateTime(new Date(recording.startTS)) %>
                        </span>
                    </div>
                </td>

                <td>
                    <%= recording.duration ? utils.formatSeconds(recording.duration) : '?' %>
                </td>

                <td>
                    <a href="/archive/recordings/<%= recording.id %>">
                        <button class="action_button">View</button>
                    </a>
                    <a href="/archive/media/videos/<%= recording.id %>" download="<%= recording.id %>.mp4">
                        <button class="action_button">Download</button>
                    </a>
                </td>
            </tr>
        <% } %>
    </tbody>
</table>