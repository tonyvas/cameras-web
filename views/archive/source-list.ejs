<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/common.css">
    <link rel="stylesheet" href="/public/css/archive/source-list.css">

    <title>Sources</title>
</head>
<body>
    <%- include('../partials/header', {active: '/archive/sources'}) -%> 

    <%
        let dateKeys = [];
        for (let counts of data.counts){
            for (let dateKey in counts){
                if (dateKeys.indexOf(dateKey) < 0){
                    dateKeys.push(dateKey);
                }
            }
        }

        dateKeys.sort();
    %>

    <hgroup>
        <h1>Sources</h1>
        <h2>Recording Count</h2>
    </hgroup>

    <main>
        <table>
            <colgroup>
                <col class="date-col">

                <% for (let source of data.sources) { %>
                    <col class="source-col">
                <% } %>

                <col class="total-col">
            </colgroup>
            <thead>
                <tr>
                    <th>Date</th>

                    <% for (let source of data.sources) { %>
                        <th scope="col" title="ID: <%= source.id %>">
                            <a href="/archive/recordings?src=<%= source.id %>">
                                <%= source.name %>
                            </a>
                        </th>
                    <% } %>

                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% 
                    let colTotals = [];
                    for (let i = 0; i < data.sources.length+1; i++){
                        colTotals[i] = 0;
                    }
                %>

                <% for (let dateKey of dateKeys) { %>
                    <% let rowTotal = 0; %>
                    
                    <tr>
                        <th scope="row">
                            <a href="/archive/recordings?date=<%= dateKey %>">
                                <%= utils.formatDate(utils.parseDateKey(dateKey)) %>
                            </a>
                        </th>
    
                        <% for (let i = 0; i < data.sources.length; i++) { %>
                            <%
                                let source = data.sources[i];
                                let counts = data.counts[i];
                                let count = counts[dateKey] ? counts[dateKey] : 0;

                                rowTotal += count;
                                colTotals[i] += count;
                            %>

                            <td>
                                <a href="/archive/recordings?src=<%= source.id %>&date=<%= dateKey %>">
                                    <%= count %>
                                </a>
                            </td>
                        <% } %>

                        <td><%= rowTotal %></td>

                        <% colTotals[colTotals.length-1] += rowTotal %>
                    </tr>
                <% } %>

                <tr>
                    <th scope="row">Total</th>

                    <% for (let total of colTotals) { %>
                        <td><%= total %></td>
                    <% } %>
                </tr>
            </tbody>
        </table>
    </main>
</body>
</html>