<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/common.css">
    <link rel="stylesheet" href="/public/css/archive/recordings-list.css">
    <link rel="stylesheet" href="/public/css/archive/recordings-list-results-nav.css">
    <link rel="stylesheet" href="/public/css/archive/recordings-list-controls.css">
    <link rel="stylesheet" href="/public/css/archive/recordings-list-table.css">

    <title>Recordings List</title>
</head>
<body>
    <%- include('../partials/header', {active: '/archive/recordings'}) -%> 

    <hgroup>
        <h1><%= data.recordings.length %> <%= data.recordings.length == 1 ? 'Recording' : 'Recordings' %></h1>
        
        <% if (data.dateKey) { %>
            <h2>
                <%= utils.formatDate(utils.parseDateKey(data.dateKey)) %>
                <br>
                <%= utils.formatSeconds(data.windowStart/1000, false) %>
                - 
                <%= utils.formatSeconds((data.windowStart + data.windowDuration-1)/1000, false) %>
            </h2>
        <% } %>
    </hgroup>


    <main>
        <div id="result_nav">
            <%- include('../partials/recording-list/results-nav') -%>
        </div>

        <div id="controls">
            <%- include('../partials/recording-list/controls') -%>
        </div>

        <div id="results">
            <%- include('../partials/recording-list/table') -%>
        </div>
    </main>

    <script src="/public/js/archive/recordings-list.js"></script>
</body>
</html>