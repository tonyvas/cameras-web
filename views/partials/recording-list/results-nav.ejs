<%
    const HOUR = 3600 * 1000;
    const DAY = 24 * HOUR;

    // Divide day into pages
    let pageDuration = data.windowDuration;
    let pageCount = Math.ceil(DAY / pageDuration);

    // Dates
    let currDate = prevDate = nextDate = null;

    // Try get current date if possible
    if (data.recordings.length > 0){
        currDate = new Date(data.recordings[0].startTS - data.recordings[0].utcOffset);
    }
    else if (data.dateKey){
        currDate = utils.parseDateKey(data.dateKey)
    }

    // If got current date, get next and previous dates too
    if (currDate){
        prevDate = new Date(currDate);
        prevDate.setDate(prevDate.getDate() - 1);
        
        nextDate = new Date(currDate);
        nextDate.setDate(nextDate.getDate() + 1);
    }

    // Window dates and times
    let currPage = data.windowPage;

    // Naively assume prev/next page and date
    let prevPage = currPage - 1;
    let nextPage = currPage + 1;
    let prevPageDate = nextPageDate = currDate;

    if (currPage == 1){
        // If currently first page, previous page is last page of previous date
        prevPage = pageCount;
        prevPageDate = prevDate;
    }

    if (currPage == pageCount){
        // If currently last page, next page is first page of next date
        nextPage = 1;
        nextPageDate = nextDate;
    }

    // Format date keys
    let currDateKey = prevDateKey = nextDateKey = prevPageDateKey = nextPageDateKey = null;

    // If dates are valid, format keys
    if (currDate){
        currDateKey = utils.formatDateKey(currDate);
        prevDateKey = utils.formatDateKey(prevDate);
        nextDateKey = utils.formatDateKey(nextDate);
    
        prevPageDateKey = utils.formatDateKey(prevPageDate);
        nextPageDateKey = utils.formatDateKey(nextPageDate);
    }

    // Format duration as key
    let currDurationKey = utils.formatTimeKey(data.windowDuration);
%>

<!-- Oldest button -->
<button
    class="arrow-button"
    id="oldest_button"
    title="Oldest"
    onclick="goOldestPage('<%= currDurationKey %>')">
    &lt;&lt;&lt;
</button>

<!-- Previous date button -->
<% if (prevDate) { %>
    <button
        class="date-button"
        id="prev_date_button"
        title="Previous Date"
        onclick="goWindowPage('<%= prevDateKey %>', '<%= currPage %>', '<%= currDurationKey %>')">
        <%= utils.formatDate(prevDate) %>
    </button>
<% } else { %>
    <button class="date-button" id="prev_date_button" title="Previous Date" disabled>???</button>
<% } %>

<!-- Previous window button -->
<% if (prevDate) { %>
    <button
        class="arrow-button"
        id="older_button"
        title="Older"
        onclick="goWindowPage('<%= prevPageDateKey %>', '<%= prevPage %>', '<%= currDurationKey %>')">
        &lt;
    </button>
<% } else { %>
    <button class="arrow-button" id="older_button" title="Older" disabled>&lt;</button>
<% } %>

<select id="window_duration_select" title="Duration" autocomplete="off" onchange="onDurationSelectChange(this);">
    <% for (let hours of [1, 2, 3, 4, 6, 8, 12, 24]) { %>
        <% let duration = hours * HOUR %>
        
        <option value="<%= hours %>,<%= utils.formatTimeKey(duration) %>" <%= duration == data.windowDuration ? 'selected':'' %>>
            <%= hours %>h
        </option>
    <% } %>
</select>

<select id="window_page_select" title="Page" autocomplete="off" onchange="onPageSelectChange(this);">
    <% for (let page = 1; page <= pageCount; page++){ %>
        <%
            let start = (page-1) * pageDuration;
            let end = page * pageDuration - 1;
        %>

        <option value="<%= currDurationKey %>,<%= page %>" <%= page == currPage ? 'selected' : '' %>>
            <%= utils.formatSeconds(start/1000) %> - <%= utils.formatSeconds(end/1000) %>
        </option>
    <% } %>
</select>

<!-- Next window button -->
<% if (nextDate) { %>
    <button
        class="arrow-button"
        id="newer_button"
        title="Newer"
        onclick="goWindowPage('<%= nextPageDateKey %>', '<%= nextPage %>', '<%= currDurationKey %>')">
        &gt;
    </button>
<% } else { %>
    <button class="arrow-button" id="newer_button" title="Newer" disabled>&gt;</button>
<% } %>

<!-- Next date button -->
<% if (nextDate) { %>
    <button
        class="date-button"
        id="next_date_button"
        title="Next Date"
        onclick="goWindowPage('<%= nextDateKey %>', '<%= currPage %>', '<%= currDurationKey %>')">
        <%= utils.formatDate(nextDate) %>
    </button>
<% } else { %>
    <button class="date-button" id="next_date_button" title="Next Date" disabled>???</button>
<% } %>

<!-- Newest button -->
<button
    class="arrow-button"
    id="newest_button"
    title="Newest"
    onclick="goNewestPage('<%= currDurationKey %>')">
    &gt;&gt;&gt;
</button>

<script>
    function onDurationSelectChange(select){
        if (select.selectedOptions.length == 0){
            return;
        }

        const pageSelect = document.getElementById('window_page_select');

        let parts = select.selectedOptions[0].value.split(',');
        let hours = Number.parseInt(parts[0]);
        let durationKey = parts[1];

        while (pageSelect.children.length > 0){
            pageSelect.removeChild(pageSelect.children[0]);
        }

        for (let page = 1; page <= 24 / hours; page++){
            let option = document.createElement('option');
            pageSelect.appendChild(option);

            let startSec = (page-1) * hours * 3600;
            let endSec = page * hours * 3600 - 1;
            
            option.value = `${durationKey},${page}`;
            option.innerHTML = `${formatSeconds(startSec)} - ${formatSeconds(endSec)}`;
        }

        pageSelect.selectedIndex = -1;
    }

    function onPageSelectChange(select){
        if (select.selectedOptions.length == 0){
            return;
        }

        let parts = select.selectedOptions[0].value.split(',');
        let durationKey = parts[0];
        let page = Number.parseInt(parts[1]);

        goWindowPage('<%= currDateKey %>', page, durationKey);
    }

    function formatSeconds(seconds){
        seconds = Math.floor(seconds);

        let hours = Math.floor(seconds / 3600);
        seconds %= 3600;

        let minutes = Math.floor(seconds / 60);
        seconds %= 60;

        return [hours, minutes, seconds].map(v => v.toString().padStart(2, '0')).join(':');
    }
</script>