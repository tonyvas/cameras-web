<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/common.css">
    <link rel="stylesheet" href="/public/css/archive/recording-details.css">

    <title>Recording <%= data.recording.id %></title>
</head>
<body>
    <%- include('../partials/header', {active: null}) -%> 

    <main>
        <hgroup>
            <h1>Recording <%= data.recording.id %></h1>
        </hgroup>

        <div id="media_container">
            <video src="/archive/media/videos/<%= data.recording.id %>" alt="<%= data.recording.id %> video" controls autoplay muted></video>

            <div id="controls">
                <button <%= data.prev ? '':'disabled' %> onclick="gotoRecording(<%= data.prev ? data.prev.id : -1 %>)">&#60;</button>
                
                <select id="speed_select">
                    <option value="1">1x</option>
                    <option value="2">2x</option>
                    <option value="4">4x</option>
                    <option value="8">8x</option>
                    <option value="16">16x</option>
                    <option value="32">32x</option>
                </select>

                <button <%= data.next ? '':'disabled' %> onclick="gotoRecording(<%= data.next ? data.next.id : -1 %>)">&#62;</button>
            </div>
        </div>

        <div id="details_container">
            <h2>Details</h2>

            <table id="details_table">
                <colgroup>
                    <col class="col_keys">
                    <col class="col_values">
                </colgroup>
                <tbody>
                    <tr>
                        <th>Source</th>
                        <td><%= data.recording.source.name %></td>
                    </tr>

                    <tr>
                        <th>Start Date</th>
                        <td>
                            <div class="recording_info_dates">
                                <span class="local_date" title="Local Date">
                                    <%= utils.formatDateTime(new Date(data.recording.startTS - data.recording.utcOffset)) %>
                                </span>
                                <span class="utc_date" title="UTC Date">
                                    <%= utils.formatDateTime(new Date(data.recording.startTS)) %>
                                </span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <th>Duration</th>
                        <td><%= data.recording.duration ? utils.formatSeconds(data.recording.duration) : '?' %></td>
                    </tr>

                    <tr>
                        <th>Size</th>
                        <td><%= data.recording.size ? utils.formatSize(data.recording.size) : '?' %></td>
                    </tr>

                    <tr>
                        <th>Bitrate</th>
                        <td><%= data.recording.bitrate ? utils.formatBitrate(data.recording.bitrate) : '?' %></td>
                    </tr>
                    
                    <tr>
                        <th>A/V Codecs</th>
                        <td>
                            <%= data.recording.audioCodec ? data.recording.audioCodec.toUpperCase() : '-' %>
                            /
                            <%= data.recording.videoCodec ? data.recording.videoCodec.toUpperCase() : '-' %>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div id="related_container">
            <h2>Related</h2>

            <table id="related_table">
                <colgroup>
                    <col class="col_source">
                    <col class="col_dates">
                    <col class="col_actions">
                </colgroup>
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Start Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% for( let r of data.related ) { %>
                        <tr>
                            <td>
                                <%= r.source.name %>
                            </td>
                            <td>
                                <div class="recording_info_dates">
                                    <span class="local_date" title="Local Date">
                                        <%= utils.formatDateTime(new Date(r.startTS - r.utcOffset)) %>
                                    </span>
                                    <span class="utc_date" title="UTC Date">
                                        <%= utils.formatDateTime(new Date(r.startTS)) %>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <a href="/archive/recordings/<%= r.id %>">
                                    <button class="action_button">View</button>
                                </a>
                                <a href="/archive/media/videos/<%= r.id %>" download="<%= r.id %>.mp4">
                                    <button class="action_button">Download</button>
                                </a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        function gotoRecording(id){
            let url = new URL(window.location);
            
            if (id >= 0){
                url.pathname = `/archive/recordings/${id}`;
                window.location = url;
            }
        }
    </script>

    <script src="/public/js/archive/recording-details.js"></script>
</body>
</html>